# ============================================================
# SMART RESUME MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ============================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database Configuration (PostgreSQL - Raw SQL, No ORM)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/smart_resume_tracker
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_resume_tracker
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Authentication & Security
JWT_SECRET=development_super_secret_jwt_key_resume_tracker_2026_xyz
JWT_EXPIRES_IN=7d
SESSION_SECRET=development_super_secret_session_key_resume_tracker_2026_abc
COOKIE_SECRET=development_super_secret_cookie_key_resume_tracker_2026_123

# AI Configuration (OpenAI API / Configurable Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000

# Redis / Background Queue (Optional in dev, falls back to in-memory queue)
REDIS_URL=redis://127.0.0.1:6379

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email Configuration (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Smart Resume AI <noreply@smartresume.ai>"

# Payment Gateways (Stripe & Razorpay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
